classDiagram
    class TimeSlot {
        +Time start
        +Time end
    }

    class Owner {
        +String name
        +int age
        +List~TimeSlot~ schedule
        +Dict preferences
        +List~Pet~ pets
        +addPet(pet Pet) void
        +removePet(pet Pet) void
        +getDailyTasks(date Date) List~Task~
    }

    class Pet {
        +String name
        +String breed
        +int age
        +Dict preferences
        +List~Owner~ owners
        +List~Task~ tasks
        +addTask(task Task) void
        +removeTask(task Task) void
    }

    class Priority {
        <<enumeration>>
        LOWEST = 1
        LOW = 2
        MEDIUM = 3
        HIGH = 4
        HIGHEST = 5
    }

    class Task {
        +String id
        +String name
        +DateTime time
        +Priority priority
        +Pet pet
        +int duration_minutes
        +String reason
        +bool completed
        +markComplete() void
        +reschedule(newTime DateTime) void
    }

    class Scheduler {
        +build_daily_schedule(owner Owner, day Date) List~Task~
        +prioritize_tasks(tasks List~Task~) List~Task~
        +detect_conflicts(tasks List~Task~) List~Task~
        +explain_choice(task Task) String
        +create_reminder(task Task) Reminder
    }

    class Reminder {
        +DateTime time
        +Priority priority
        +Task task
        +String message
        +send() void
        +snooze(minutes int) void
    }

    Owner "1..*" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Task "0..*" --> "0..1" Pet : belongs to
    Task ..> Priority
    Owner "1" --> "0..*" TimeSlot : available during
    Scheduler ..> Owner : reads schedule and preferences
    Scheduler ..> Task : orders
    Reminder "0..*" --> "1" Task : notifies about
    Scheduler ..> Reminder : creates
