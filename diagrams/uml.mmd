classDiagram
    class Owner {
        +String name
        +int age
        +List~TimeSlot~ schedule
        +Dict preferences
        +List~Pet~ pets
        +addPet(pet Pet) void
        +removePet(pet Pet) void
        +getDailyTasks(date Date) List~Task~
    }

    class Pet {
        +String name
        +String breed
        +int age
        +Dict preferences
        +List~Owner~ owners
        +List~Task~ tasks
        +addTask(task Task) void
        +removeTask(task Task) void
    }

    class Task {
        +String name
        +DateTime time
        +int priority
        +String reason
        +bool completed
        +markComplete() void
        +reschedule(newTime DateTime) void
    }

    class Scheduler {
        +List~Task~ tasks
        +buildDailySchedule(owner Owner, date Date) List~Task~
        +prioritizeTasks(tasks List~Task~) List~Task~
        +detectConflicts(tasks List~Task~) List~Task~
        +explainChoice(task Task) String
    }

    class Reminder {
        +DateTime time
        +int priority
        +Task task
        +String message
        +send() void
        +snooze(minutes int) void
    }

    Owner "1..*" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads schedule and preferences
    Scheduler --> "0..*" Task : orders
    Reminder "0..*" --> "1" Task : notifies about
    Scheduler ..> Reminder : creates
